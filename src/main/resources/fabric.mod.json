		"main": [
			"net.rngk.mushncav.MushroomsAndCaverns"
		],
		"client": [
			"net.rngk.mushncav.MushroomsAndCavernsClient"
		],
		"fabric-datagen": [
			"net.rngk.mushncav.MushroomsAndCavernsDataGenerator"
		],
		"terrablender": [
