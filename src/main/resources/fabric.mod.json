{
	"schemaVersion": 1,
	"id": "mushncav",
	"version": "${version}",
	"name": "Mushrooms and Caverns",
	"description": "Mod that introduces new biomes, blocks, and more!",
	"authors": [
		"rngk"
	],
	"contact": {
		"homepage": "https://rngkgit.github.io/",
		"sources": "https://github.com/rngkGit/mushncav"
	},
	"license": "MIT",
	"icon": "assets/mushncav/icon.png",
	"environment": "*",
